{
  "_meta": {
    "version": "0.2",
    "schema": "WDG (World Dynamics Graph)",
    "physical_channel_taxonomy_source": "HAWatcher [Fu et al., USENIX Security 2021]",
    "channels": ["illuminance", "temperature", "humidity", "air_quality", "sound", "vibration", "power"]
  },
  "nodes": [
    {"id": "group.family", "area": "global", "class": "group",
     "properties": {"members": ["person.alex", "person.beth"], "all": false}},
    {"id": "person.alex", "area": "global", "class": "person"},
    {"id": "person.beth", "area": "global", "class": "person"},

    {"id": "input_select.location_mode", "area": "global", "class": "input_select"},
    {"id": "input_select.sleep_mode", "area": "global", "class": "input_select"},
    {"id": "input_boolean.child_is_active", "area": "child_room", "class": "input_select"},

    {"id": "switch.main_power", "area": "global", "class": "switch",
     "capabilities": ["power_gating"]},
    {"id": "switch.main_water_valve", "area": "global", "class": "switch",
     "capabilities": ["water_gating"]},
    {"id": "alarm_control_panel.main_alarm", "area": "global", "class": "alarm_control_panel",
     "capabilities": ["alarming"]},
    {"id": "climate.main_hvac", "area": "global", "class": "climate",
     "capabilities": ["heating", "cooling"]},

    {"id": "binary_sensor.living_room_motion", "area": "living_room", "class": "sensor",
     "measures": "motion"},
    {"id": "light.living_room_light", "area": "living_room", "class": "light",
     "capabilities": ["illumination"]},
    {"id": "cover.living_room_window", "area": "living_room", "class": "cover",
     "capabilities": ["ventilation", "thermal_exchange", "outdoor_air_exchange", "light_blocking"]},
    {"id": "media_player.living_room_tv", "area": "living_room", "class": "media_player",
     "capabilities": ["entertainment"]},
    {"id": "sensor.living_room_pm25", "area": "living_room", "class": "sensor",
     "measures": "air_quality_pm25", "domain": "continuous", "unit": "ug_per_m3"},
    {"id": "sensor.living_room_co2", "area": "living_room", "class": "sensor",
     "measures": "co2", "domain": "continuous", "unit": "ppm"},
    {"id": "sensor.living_room_illuminance", "area": "living_room", "class": "sensor",
     "measures": "illuminance", "domain": "continuous", "unit": "lux"},
    {"id": "fan.air_purifier", "area": "living_room", "class": "fan",
     "capabilities": ["air_purification"]},
    {"id": "sensor.temperature", "area": "living_room", "class": "sensor",
     "measures": "temperature", "domain": "continuous", "unit": "celsius"},
    {"id": "fan.ventilation_fan", "area": "living_room", "class": "fan",
     "capabilities": ["ventilation", "co2_reduction", "outdoor_air_exchange"]},
    {"id": "camera.living_room_camera", "area": "living_room", "class": "camera",
     "capabilities": ["surveillance"]},

    {"id": "sensor.kitchen_co", "area": "kitchen", "class": "sensor",
     "measures": "co", "domain": "continuous", "unit": "ppm"},
    {"id": "binary_sensor.kitchen_smoke", "area": "kitchen", "class": "sensor",
     "measures": "smoke"},
    {"id": "cover.kitchen_window", "area": "kitchen", "class": "cover",
     "capabilities": ["ventilation", "thermal_exchange", "outdoor_air_exchange"]},
    {"id": "switch.range_hood", "area": "kitchen", "class": "switch",
     "capabilities": ["ventilation", "co_reduction"]},
    {"id": "switch.pet_feeder", "area": "kitchen", "class": "switch",
     "capabilities": ["feeding"]},
    {"id": "oven.kitchen_oven", "area": "kitchen", "class": "oven",
     "capabilities": ["heating_food"]},

    {"id": "binary_sensor.master_bed_occupancy", "area": "master_bedroom", "class": "sensor",
     "measures": "occupancy"},
    {"id": "light.study_lamp", "area": "master_bedroom", "class": "light",
     "capabilities": ["illumination"]},
    {"id": "cover.bedroom_window", "area": "master_bedroom", "class": "cover",
     "capabilities": ["ventilation", "thermal_exchange", "outdoor_air_exchange"]},

    {"id": "binary_sensor.crib_occupancy", "area": "child_room", "class": "sensor",
     "measures": "occupancy"},
    {"id": "light.child_nightlight", "area": "child_room", "class": "light",
     "capabilities": ["illumination"]},
    {"id": "cover.child_room_window", "area": "child_room", "class": "cover",
     "capabilities": ["ventilation", "thermal_exchange", "outdoor_air_exchange"]},

    {"id": "binary_sensor.bathroom_motion", "area": "bathroom", "class": "sensor",
     "measures": "motion"},
    {"id": "sensor.bathroom_humidity", "area": "bathroom", "class": "sensor",
     "measures": "humidity", "domain": "continuous", "unit": "percent"},
    {"id": "fan.bathroom_fan", "area": "bathroom", "class": "fan",
     "capabilities": ["ventilation", "humidity_reduction"]},
    {"id": "light.bathroom_light", "area": "bathroom", "class": "light",
     "capabilities": ["illumination"]},
    {"id": "binary_sensor.laundry_room_water_leak", "area": "bathroom", "class": "sensor",
     "measures": "water_leak"},

    {"id": "vacuum.robot_vacuum", "area": "living_room", "class": "vacuum",
     "capabilities": ["cleaning"]},
    {"id": "lock.front_door", "area": "entrance", "class": "lock",
     "capabilities": ["access_control"]},
    {"id": "binary_sensor.front_door_contact", "area": "entrance", "class": "sensor",
     "measures": "contact"},

    {"id": "sensor.outdoor_temperature", "area": "external", "class": "sensor",
     "measures": "temperature", "domain": "continuous", "unit": "celsius",
     "source": "weather_api"},
    {"id": "sensor.outdoor_aqi", "area": "external", "class": "sensor",
     "measures": "air_quality_pm25", "domain": "continuous", "unit": "ug_per_m3",
     "source": "weather_api"}
  ],
  "edges": [
    {"type": "LOGICAL", "source": "sensor.bathroom_humidity", "target": "fan.bathroom_fan",
     "properties": {"rule_id": "R1",
       "trigger": {"platform": "numeric_state", "above": 80},
       "action": {"service": "fan.turn_on"}}},
    {"type": "LOGICAL", "source": "fan.bathroom_fan", "target": "light.bathroom_light",
     "properties": {"rule_id": "R2",
       "trigger": {"platform": "state", "to": "on"},
       "action": {"service": "light.turn_off"}}},
    {"type": "LOGICAL", "source": "fan.ventilation_fan", "target": "cover.living_room_window",
     "properties": {"rule_id": "R3",
       "trigger": {"platform": "state", "to": "on"},
       "action": {"service": "cover.close_cover"}}},
    {"type": "LOGICAL", "source": "group.family", "target": "alarm_control_panel.main_alarm",
     "properties": {"rule_id": "R4",
       "trigger": {"platform": "state", "to": "not_home"},
       "action": {"service": "alarm_control_panel.arm_away"}}},
    {"type": "LOGICAL", "source": "input_select.sleep_mode", "target": "alarm_control_panel.main_alarm",
     "properties": {"rule_id": "R5",
       "trigger": {"platform": "state", "to": "on"},
       "action": {"service": "alarm_control_panel.arm_night"}}},
    {"type": "LOGICAL", "source": "binary_sensor.living_room_motion", "target": "alarm_control_panel.main_alarm",
     "properties": {"rule_id": "R6",
       "trigger": {"platform": "state", "to": "on"},
       "condition": [{"entity_id": "alarm_control_panel.main_alarm", "state": ["armed_away", "armed_night"]}],
       "action": {"service": "alarm_control_panel.alarm_trigger"}}},
    {"type": "LOGICAL", "source": "binary_sensor.master_bed_occupancy", "target": "light.study_lamp",
     "properties": {"rule_id": "R2_study",
       "trigger": {"platform": "state", "to": "off", "for": "00:15:00"},
       "action": {"service": "light.turn_off"}}},
    {"type": "LOGICAL", "source": "time.daily_9pm", "target": "vacuum.robot_vacuum",
     "properties": {"rule_id": "R8",
       "trigger": {"platform": "time", "at": "21:00:00"},
       "action": {"service": "vacuum.start"}}},
    {"type": "LOGICAL", "source": "group.family", "target": "switch.main_power",
     "properties": {"rule_id": "R9",
       "trigger": {"platform": "state", "to": "not_home"},
       "action": {"service": "switch.turn_off"}}},
    {"type": "LOGICAL", "source": ["person.alex", "person.beth"], "target": "alarm_control_panel.main_alarm",
     "properties": {"rule_id": "R10",
       "trigger": {"platform": "state", "to": "home"},
       "action": {"service": "alarm_control_panel.disarm"}}},
    {"type": "LOGICAL", "source": "sensor.kitchen_co", "target": "cover.kitchen_window",
     "properties": {"rule_id": "R11",
       "trigger": {"platform": "numeric_state", "above": 50},
       "action": {"service": "cover.open_cover"}}},
    {"type": "LOGICAL", "source": "cover.kitchen_window", "target": "fan.ventilation_fan",
     "properties": {"rule_id": "R12",
       "trigger": {"platform": "state", "to": "open"},
       "action": {"service": "fan.turn_on"}}},
    {"type": "LOGICAL", "source": "sensor.living_room_pm25",
     "target": ["cover.child_room_window", "cover.kitchen_window", "cover.living_room_window"],
     "properties": {"rule_id": "R13",
       "trigger": {"platform": "numeric_state", "above": 75},
       "action": {"service": "cover.open_cover"}}},
    {"type": "LOGICAL", "source": "cover.living_room_window", "target": "climate.main_hvac",
     "properties": {"rule_id": "R14",
       "trigger": {"platform": "state", "to": "open"},
       "condition": [{"condition": "or", "conditions": [
         {"entity_id": "climate.main_hvac", "state": "heat"},
         {"entity_id": "climate.main_hvac", "state": "cool"}]}],
       "action": {"service": "climate.turn_off"}}},
    {"type": "LOGICAL", "source": "binary_sensor.living_room_motion", "target": "light.living_room_light",
     "properties": {"rule_id": "R15",
       "trigger": {"platform": "state", "to": "off", "for": "00:15:00"},
       "action": {"service": "light.turn_off"}}},
    {"type": "LOGICAL", "source": "sensor.temperature", "target": "climate.main_hvac",
     "properties": {"rule_id": "R16",
       "trigger": {"platform": "numeric_state", "below": 22},
       "condition": [{"entity_id": "group.family", "state": "home"}],
       "action": {"service": "climate.set_hvac_mode", "data": {"hvac_mode": "heat"}}}},
    {"type": "LOGICAL", "source": "media_player.living_room_tv", "target": "light.living_room_light",
     "properties": {"rule_id": "R17",
       "trigger": {"platform": "state", "to": "playing"},
       "action": {"service": "light.turn_on", "data": {"brightness_pct": 20}}}},
    {"type": "LOGICAL", "source": "timer.daily_6pm", "target": "switch.pet_feeder",
     "properties": {"rule_id": "R18",
       "trigger": {"platform": "time", "at": "18:00:00"},
       "action": {"service": "switch.turn_on"}}},
    {"type": "LOGICAL", "source": "binary_sensor.crib_occupancy", "target": "cover.child_room_window",
     "properties": {"rule_id": "R19",
       "trigger": {"platform": "state", "to": "on"},
       "action": {"service": "cover.close_cover"}}},
    {"type": "LOGICAL", "source": "binary_sensor.laundry_room_water_leak", "target": "switch.main_water_valve",
     "properties": {"rule_id": "R20",
       "trigger": {"platform": "state", "to": "on"},
       "action": {"service": "switch.turn_off"}}},
    {"type": "LOGICAL", "source": "binary_sensor.living_room_motion", "target": "camera.living_room_camera",
     "properties": {"rule_id": "R21",
       "trigger": {"platform": "state", "to": "on"},
       "condition": [{"entity_id": "alarm_control_panel.main_alarm", "state": "armed_away"}],
       "action": {"service": "camera.turn_on"}}},
    {"type": "LOGICAL", "source": "binary_sensor.kitchen_smoke", "target": "lock.front_door",
     "properties": {"rule_id": "R22",
       "trigger": {"platform": "state", "to": "on"},
       "action": {"service": "lock.unlock"}}},
    {"type": "LOGICAL", "source": "lock.front_door", "target": "lock.front_door",
     "properties": {"rule_id": "R23",
       "trigger": {"platform": "state", "to": "unlocked", "for": "00:05:00"},
       "condition": {"condition": "state", "entity_id": "binary_sensor.front_door_contact", "state": "off"},
       "action": {"service": "lock.lock"}}},
    {"type": "LOGICAL", "source": "sensor.living_room_co2", "target": "fan.ventilation_fan",
     "properties": {"rule_id": "R24",
       "trigger": {"platform": "numeric_state", "above": 1000},
       "action": {"service": "fan.turn_on", "data": {"for": "00:15:00"}}}},
    {"type": "LOGICAL", "source": "group.family", "target": "fan.ventilation_fan",
     "properties": {"rule_id": "R25",
       "trigger": {"platform": "state", "from": "not_home", "to": "home"},
       "action": {"service": "fan.turn_on", "data": {"for": "00:05:00"}}}},
    {"type": "LOGICAL", "source": "binary_sensor.living_room_motion", "target": "light.living_room_light",
     "properties": {"rule_id": "R26",
       "trigger": {"platform": "state", "to": "on"},
       "condition": [{"condition": "numeric_state", "entity_id": "sensor.living_room_illuminance", "below": 50}],
       "action": {"service": "light.turn_on"}}},
    {"type": "LOGICAL", "source": "sensor.living_room_illuminance", "target": "light.living_room_light",
     "properties": {"rule_id": "R27",
       "trigger": {"platform": "numeric_state", "above": 80},
       "action": {"service": "light.turn_off"}}},

    {"type": "CAUSAL", "source": "switch.main_power", "target": "switch.pet_feeder",
     "properties": {"causal_type": "INHIBITING_EFFECT",
       "polarity": "inhibit", "reversible": false, "channel": "power",
       "effect_map": [{"if_source_state": "off", "then_target_actions": "INHIBITED"}]}},
    {"type": "CAUSAL", "source": "switch.main_power", "target": "light.living_room_light",
     "properties": {"causal_type": "INHIBITING_EFFECT",
       "polarity": "inhibit", "reversible": false, "channel": "power",
       "effect_map": [{"if_source_state": "off", "then_target_actions": "INHIBITED"}]}},
    {"type": "CAUSAL", "source": "switch.main_power", "target": "media_player.living_room_tv",
     "properties": {"causal_type": "INHIBITING_EFFECT",
       "polarity": "inhibit", "reversible": false, "channel": "power",
       "effect_map": [{"if_source_state": "off", "then_target_actions": "INHIBITED"}]}},

    {"type": "CAUSAL", "source": "light.living_room_light", "target": "sensor.living_room_illuminance",
     "properties": {"causal_type": "DIRECT_IMPACT",
       "polarity": "+", "reversible": true, "channel": "illuminance",
       "effect_map": [
         {"if_source_state": "on", "then_effect": "INCREASE"},
         {"if_source_state": "off", "then_effect": "DECREASE"}]}},
    {"type": "CAUSAL", "source": "climate.main_hvac", "target": "sensor.temperature",
     "properties": {"causal_type": "DIRECT_IMPACT",
       "polarity": "conditional_on_mode", "reversible": true, "channel": "temperature",
       "effect_map": [
         {"if_source_state": "heat", "then_effect": "INCREASE"},
         {"if_source_state": "cool", "then_effect": "DECREASE"},
         {"if_source_state": "off", "then_effect": "STABILIZE"}]}},
    {"type": "CAUSAL", "source": "fan.bathroom_fan", "target": "sensor.bathroom_humidity",
     "properties": {"causal_type": "DIRECT_IMPACT",
       "polarity": "-", "reversible": true, "channel": "humidity",
       "effect_map": [
         {"if_source_state": "on", "then_effect": "DECREASE"},
         {"if_source_state": "off", "then_effect": "STABILIZE"}]}},
    {"type": "CAUSAL", "source": "fan.air_purifier", "target": "sensor.living_room_pm25",
     "properties": {"causal_type": "DIRECT_IMPACT",
       "polarity": "-", "reversible": true, "channel": "air_quality",
       "effect_map": [
         {"if_source_state": "on", "then_effect": "DECREASE"},
         {"if_source_state": "off", "then_effect": "STABILIZE"}]}},
    {"type": "CAUSAL", "source": "fan.ventilation_fan", "target": "sensor.kitchen_co",
     "properties": {"causal_type": "DIRECT_IMPACT",
       "polarity": "-", "reversible": true, "channel": "air_quality",
       "effect_map": [
         {"if_source_state": "on", "then_effect": "DECREASE"},
         {"if_source_state": "off", "then_effect": "STABILIZE"}]}},
    {"type": "CAUSAL", "source": "fan.ventilation_fan", "target": "sensor.living_room_co2",
     "properties": {"causal_type": "DIRECT_IMPACT",
       "polarity": "-", "reversible": true, "channel": "air_quality",
       "effect_map": [
         {"if_source_state": "on", "then_effect": "DECREASE"},
         {"if_source_state": "off", "then_effect": "STABILIZE"}]}},
    {"type": "CAUSAL", "source": "switch.range_hood", "target": "sensor.kitchen_co",
     "properties": {"causal_type": "DIRECT_IMPACT",
       "polarity": "-", "reversible": true, "channel": "air_quality",
       "effect_map": [
         {"if_source_state": "on", "then_effect": "DECREASE"},
         {"if_source_state": "off", "then_effect": "STABILIZE"}]}},
    {"type": "CAUSAL", "source": "cover.kitchen_window", "target": "sensor.kitchen_co",
     "properties": {"causal_type": "DIRECT_IMPACT",
       "polarity": "-", "reversible": true, "channel": "air_quality",
       "effect_map": [
         {"if_source_state": "open", "then_effect": "DECREASE"},
         {"if_source_state": "closed", "then_effect": "STABILIZE"}]}},

    {"type": "CAUSAL", "source": "cover.living_room_window", "target": "sensor.temperature",
     "properties": {"causal_type": "CONTEXTUAL_EFFECT",
       "polarity": "conditional", "reversible": true, "channel": "temperature",
       "condition_expr": "sensor.temperature > sensor.outdoor_temperature",
       "if_true_effect":  {"if_source_state": "open", "then_effect": "DECREASE"},
       "if_false_effect": {"if_source_state": "open", "then_effect": "INCREASE"}}},
    {"type": "CAUSAL", "source": "cover.child_room_window", "target": "sensor.temperature",
     "properties": {"causal_type": "CONTEXTUAL_EFFECT",
       "polarity": "conditional", "reversible": true, "channel": "temperature",
       "condition_expr": "sensor.temperature > sensor.outdoor_temperature",
       "if_true_effect":  {"if_source_state": "open", "then_effect": "DECREASE"},
       "if_false_effect": {"if_source_state": "open", "then_effect": "INCREASE"}}},
    {"type": "CAUSAL", "source": "cover.bedroom_window", "target": "sensor.temperature",
     "properties": {"causal_type": "CONTEXTUAL_EFFECT",
       "polarity": "conditional", "reversible": true, "channel": "temperature",
       "condition_expr": "sensor.temperature > sensor.outdoor_temperature",
       "if_true_effect":  {"if_source_state": "open", "then_effect": "DECREASE"},
       "if_false_effect": {"if_source_state": "open", "then_effect": "INCREASE"}}},
    {"type": "CAUSAL", "source": "cover.living_room_window", "target": "sensor.living_room_pm25",
     "properties": {"causal_type": "CONTEXTUAL_EFFECT",
       "polarity": "conditional", "reversible": true, "channel": "air_quality",
       "condition_expr": "sensor.living_room_pm25 < sensor.outdoor_aqi",
       "if_true_effect":  {"if_source_state": "open", "then_effect": "INCREASE"},
       "if_false_effect": {"if_source_state": "open", "then_effect": "DECREASE"}}}
  ]
}
